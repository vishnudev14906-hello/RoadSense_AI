# RoadSense AI - Environment Configuration Example

# Database
DATABASE_URL=sqlite:///./app/data/roadsense.db

# JWT Security
JWT_SECRET=roadsense_ai_super_secure_jwt_secret_key_2026_prod
JWT_EXPIRE_MINUTES=1440
JWT_REMEMBER_ME_EXPIRE_MINUTES=10080

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
