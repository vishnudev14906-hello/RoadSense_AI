# RoadSense AI - Backend Environment Configuration

# Database Configuration
DATABASE_URL=sqlite:///./app/data/roadsense.db

# JWT Security
JWT_SECRET=roadsense_ai_super_secure_jwt_secret_key_2026_prod
JWT_EXPIRE_MINUTES=1440
JWT_REMEMBER_ME_EXPIRE_MINUTES=10080

# Google OAuth 2.0 Configuration
# Create OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173
# Authorized Redirect URIs: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Optional - for production email resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
