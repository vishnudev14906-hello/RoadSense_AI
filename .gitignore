# ==============================================================================
# RoadSense AI - Root .gitignore
# ==============================================================================

# Environment variables & secrets (NEVER COMMIT)
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node.js & Frontend dependencies / builds
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Temporary Files
logs/
*.log
*.tmp
